{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@passwo/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@passwo/study-engine": [
        "packages/study-engine/src/index.ts"
      ],
      "@passwo/training-engine": [
        "packages/training-engine/src/index.ts"
      ],
      "@passwo/training-content": [
        "packages/training-content/src/index.ts"
      ],
      "@passwo/password-analysis": [
        "packages/password-analysis/src/index.ts"
      ],
      "@passwo/visualization": [
        "packages/visualization/src/index.ts"
      ],
      "@passwo/ui": [
        "packages/ui/src/index.ts"
      ]
    },
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  }
}
