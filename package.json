{
  "name": "passwo-authentication-onboarding",
  "version": "0.1.2",
  "private": true,
  "description": "Complete PassWo authentication onboarding and between-subjects web study runtime.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "preinstall": "node ./scripts/verify-toolchain.mjs",
    "dev": "pnpm desktop:dev",
    "build": "pnpm typecheck && pnpm --filter @passwo/study-server build && pnpm --filter @passwo/study-web build && pnpm --filter @passwo/study-desktop build",
    "build:web-runtime": "pnpm --filter @passwo/study-server build && pnpm --filter @passwo/study-web build && node ./scripts/precompress-web-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "pnpm test:core",
    "test:core": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ./scripts/build-reference-artifact.mjs && node ./scripts/verify-reference-artifact.mjs && playwright test tests/e2e/study-full-flow.spec.ts",
    "test:web:release": "node ./scripts/test-web-release.mjs",
    "test:desktop": "node ./scripts/test-desktop.mjs",
    "test:reference-artifact": "node ./scripts/build-reference-artifact.mjs && node ./scripts/verify-reference-artifact.mjs && pnpm build && node ./scripts/test-reference-completion.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check:biome": "biome check .",
    "check:research-boundary": "node ./scripts/check-research-boundary.mjs",
    "check:reference-artifact": "node ./scripts/verify-reference-artifact.mjs",
    "check": "pnpm check:biome && pnpm typecheck && pnpm check:research-boundary",
    "desktop:dev": "node ./scripts/build-reference-artifact.mjs && node ./scripts/verify-reference-artifact.mjs && pnpm build && pnpm exec electron-forge start apps/study-desktop",
    "dev:secaware": "STUDY_ASSIGNMENT_MODE=forced-reference pnpm dev",
    "desktop:package": "node ./scripts/build-reference-artifact.mjs && node ./scripts/verify-reference-artifact.mjs && pnpm build && pnpm --filter @passwo/study-desktop run package",
    "study:export": "tsx ./scripts/export-study.ts",
    "study:export:server": "bash ./scripts/export-study-server.sh",
    "study:delete": "tsx ./scripts/delete-study-data.ts",
    "study:web:start": "pnpm --filter @passwo/study-server start:production",
    "followup:export-schedule": "tsx ./scripts/export-followup-schedule.ts",
    "followup:run-scheduler": "tsx ./scripts/run-followup-scheduler.ts",
    "followup:confirm-delivery": "tsx ./scripts/confirm-followup-delivery.ts",
    "followup:delete-contacts": "tsx ./scripts/delete-followup-contacts.ts",
    "followup:operations-dry-run": "tsx ./scripts/dry-run-followup-operations.ts",
    "clean": "node ./scripts/clean.mjs",
    "study:audit-data": "tsx ./scripts/audit-study-data.ts",
    "study:timing-report": "tsx ./scripts/report-study-timing.ts",
    "study:stats": "bash ./scripts/study-stats/show-current-stats.sh",
    "deploy:prepare-native": "bash ./deploy/scripts/prepare-native-dependencies.sh",
    "qa:live:setup": "bash ./deploy/scripts/setup-live-qa.sh",
    "deploy:web": "bash ./deploy/scripts/deploy-web.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.5.0",
    "@passwo/contracts": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^13.0.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0"
  }
}
